# Copy to deploy/.env on the server and fill in.

# Public hostname for the API. With no domain, use <your-ip-with-dashes>.sslip.io,
# e.g. 140-238-12-34.sslip.io for IP 140.238.12.34
API_DOMAIN=

# Password for the bundled Postgres database (pick any long random string)
POSTGRES_PASSWORD=

# JWT settings
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudflare R2 (same values as your local .env)
API_TOKEN=
ACCOUNT_ID=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET_NAME=

# Your Cloudflare Pages URL, e.g. https://trackify.pages.dev
CORS_ORIGINS=
